APP_ENV=local
DATABASE_URL=postgresql://at_app:replace-with-local-password@127.0.0.1:5432/at_project_hub
POSTGRES_PASSWORD=replace-with-local-password
DEV_AUTH=true
# Production: APP_ENV=production, DEV_AUTH=false; verified OIDC custom claims at_role/at_team
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Separate frontend development origin; production can proxy /api on the same origin.
CORS_ORIGINS=["http://127.0.0.1:4173","http://localhost:4173"]

# Local Python uses ./var/attachments; Docker sets /data/attachments. Mount persistent storage.
# ATTACHMENT_DIR=./var/attachments
ATTACHMENT_MAX_BYTES=20971520
